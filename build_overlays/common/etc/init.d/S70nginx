#!/bin/sh
#
# Serves the selected web frontend and proxies Moonraker on port 4000.
#
# Mainsail and Fluidd both look for Moonraker on the port the page is served
# from, so the frontend and the API must share one port.
#

FRONTEND_LINK=/var/www/frontend
NGINX=/usr/sbin/nginx
PID_FILE=/run/nginx.pid

ensure_layout() {
    mkdir -p /var/www /tmp/nginx/body /tmp/nginx/proxy /tmp/nginx/fastcgi \
             /tmp/nginx/uwsgi /tmp/nginx/scgi

    # The selected frontend is tracked by the executable bit of its init
    # script, the same state the SWITCH_FRONTEND macro manages.
    if [ ! -e "$FRONTEND_LINK" ]; then
        if [ -x /etc/init.d/S70mainsail ]; then
            ln -sfn /opt/mainsail "$FRONTEND_LINK"
        else
            ln -sfn /opt/fluidd "$FRONTEND_LINK"
        fi
    fi
}

start() {
    ensure_layout
    printf "Starting nginx: "
    start-stop-daemon -S -q -b -m -p "$PID_FILE" --exec "$NGINX"
    if [ $? = 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
}

stop() {
    printf "Stopping nginx: "
    start-stop-daemon -K -q -p "$PID_FILE"
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
