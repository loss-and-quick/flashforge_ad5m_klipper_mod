types {
    text/html                             html htm;
    text/css                              css;
    application/javascript                js mjs;
    application/json                      json map;
    application/manifest+json             webmanifest;
    image/svg+xml                         svg;
    image/png                             png;
    image/jpeg                            jpg jpeg;
    image/gif                             gif;
    image/x-icon                          ico;
    font/woff                             woff;
    font/woff2                            woff2;
    font/ttf                              ttf;
    text/plain                            txt;
    application/wasm                      wasm;
}
