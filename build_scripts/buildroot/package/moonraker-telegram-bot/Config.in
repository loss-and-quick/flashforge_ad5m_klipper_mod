config BR2_PACKAGE_MOONRAKER_TELEGRAM_BOT
	bool "moonraker-telegram-bot"
	depends on BR2_PACKAGE_MOONRAKER
	select BR2_PACKAGE_PYTHON_AIOLIMITER
	select BR2_PACKAGE_PYTHON_ANYIO
	select BR2_PACKAGE_PYTHON_APSCHEDULER
    select BR2_PACKAGE_PYTHON_EMOJI
	select BR2_PACKAGE_PYTHON_HTTPCORE
	select BR2_PACKAGE_PYTHON_HTTPX
	select BR2_PACKAGE_PYTHON_IDNA
	select BR2_PACKAGE_PYTHON_ORJSON
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_PYTHON_TELEGRAM_BOT
	select BR2_PACKAGE_PYTHON_SOCKSIO
	select BR2_PACKAGE_PYTHON_H2
	select BR2_PACKAGE_PYTHON_CACHETOOLS
	select BR2_PACKAGE_PYTHON_TZLOCAL
	select BR2_PACKAGE_PYTHON_UVLOOP
	select BR2_PACKAGE_PYTHON_WEBSOCKETS
	help
	  Telegram bot to interact with Moonraker (Klipper Web API Server)

	  https://github.com/nlef/moonraker-telegram-bot