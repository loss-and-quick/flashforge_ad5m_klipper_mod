#!/bin/sh
#
# Selects the frontend that nginx serves. The executable bit of this script is
# the selection state: exactly one of S70fluidd/S70mainsail may be executable.
#

FRONTEND_LINK=/var/www/frontend
WEBROOT=/opt/fluidd

select_frontend() {
    mkdir -p /var/www
    ln -sfn "$WEBROOT" "$FRONTEND_LINK"
    if [ -x /etc/init.d/S70nginx ]; then
        start-stop-daemon -K -q -p /run/nginx.pid 2>/dev/null
        sleep 1
        /etc/init.d/S70nginx start >/dev/null 2>&1
    fi
}

case "$1" in
    start|restart|reload)
        select_frontend
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
