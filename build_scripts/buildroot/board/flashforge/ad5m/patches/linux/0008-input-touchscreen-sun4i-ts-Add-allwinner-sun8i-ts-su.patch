From d4e72828ba34189746431c0d5a17e0bcf7550660 Mon Sep 17 00:00:00 2001
From: minicx <minicx@disroot.org>
Date: Fri, 20 Nov 2026 08:19:00 +0300
Subject: [PATCH] input: touchscreen: sun4i-ts: Add allwinner,sun8i-ts support

---
 drivers/input/touchscreen/sun4i-ts.c | 29 ++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/drivers/input/touchscreen/sun4i-ts.c b/drivers/input/touchscreen/sun4i-ts.c
index bb3c607..3452441 100644
--- a/drivers/input/touchscreen/sun4i-ts.c
+++ b/drivers/input/touchscreen/sun4i-ts.c
@@ -38,6 +38,8 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/clk.h>
+#include <linux/reset.h>
 
 #define TP_CTRL0		0x00
 #define TP_CTRL1		0x04
@@ -244,6 +246,9 @@ static int sun4i_ts_probe(struct platform_device *pdev)
 	u32 tp_sensitive_adjust = 15;
 	u32 filter_type = 1;
 
+	struct reset_control *rst;
+	struct clk *clk;
+
 	ts = devm_kzalloc(dev, sizeof(struct sun4i_ts_data), GFP_KERNEL);
 	if (!ts)
 		return -ENOMEM;
@@ -251,6 +256,22 @@ static int sun4i_ts_probe(struct platform_device *pdev)
 	ts->dev = dev;
 	ts->ignore_fifo_data = true;
 	ts->temp_data = -1;
+
+	rst = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(rst))
+		return PTR_ERR(rst);
+	error = reset_control_deassert(rst);
+	if (error)
+		return error;
+
+	clk = devm_clk_get_optional_enabled(dev, "mod");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	clk = devm_clk_get_optional_enabled(dev, "bus");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
 	if (of_device_is_compatible(np, "allwinner,sun6i-a31-ts")) {
 		/* Allwinner SDK has temperature (C) = (value / 6) - 271 */
 		ts->temp_offset = 271000;
@@ -358,8 +379,11 @@ static int sun4i_ts_probe(struct platform_device *pdev)
 
 	thermal = devm_thermal_of_zone_register(ts->dev, 0, ts,
 						&sun4i_ts_tz_ops);
-	if (IS_ERR(thermal))
-		return PTR_ERR(thermal);
+	if (IS_ERR(thermal)) {
+		if (PTR_ERR(thermal) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		dev_warn(ts->dev, "thermal zone not available: %ld\n", PTR_ERR(thermal));
+	}
 
 	writel(TEMP_IRQ_EN(1), ts->base + TP_INT_FIFOC);
 
@@ -393,6 +417,7 @@ static const struct of_device_id sun4i_ts_of_match[] = {
 	{ .compatible = "allwinner,sun4i-a10-ts", },
 	{ .compatible = "allwinner,sun5i-a13-ts", },
 	{ .compatible = "allwinner,sun6i-a31-ts", },
+	{ .compatible = "allwinner,sun8i-ts", },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sun4i_ts_of_match);
-- 
2.56.0

