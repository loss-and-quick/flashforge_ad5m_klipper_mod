#!/bin/sh
#
# Serves the selected web frontend and proxies Moonraker on port 4000.
#
# Mainsail and Fluidd both look for Moonraker on the port the page is served
# from, so the frontend and the API have to share one port.
#

FRONTEND_LINK=/var/www/frontend
NGINX=/usr/sbin/nginx
PID_FILE=/run/nginx.pid

nginx_running() {
    [ -s "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

ensure_layout() {
    mkdir -p /var/www /tmp/nginx/body /tmp/nginx/proxy /tmp/nginx/fastcgi \
             /tmp/nginx/uwsgi /tmp/nginx/scgi

    # The selected frontend is tracked by the executable bit of its init
    # script, the same state the SWITCH_FRONTEND macro manages.
    if [ ! -e "$FRONTEND_LINK" ]; then
        if [ -x /etc/init.d/S70mainsail ]; then
            ln -sfn /opt/mainsail "$FRONTEND_LINK"
        else
            ln -sfn /opt/fluidd "$FRONTEND_LINK"
        fi
    fi
}

start() {
    ensure_layout
    printf "Starting nginx: "
    if nginx_running; then
        echo "already running"
        return 0
    fi
    # nginx daemonises itself and writes the master pid to PID_FILE.
    if "$NGINX" -c /etc/nginx/nginx.conf; then
        echo "OK"
    else
        echo "FAIL"
        return 1
    fi
}

stop() {
    printf "Stopping nginx: "
    if ! nginx_running; then
        echo "not running"
        rm -f "$PID_FILE"
        return 0
    fi
    # A graceful shutdown waits for open connections to finish, and the
    # Moonraker websocket stays open as long as a browser does, so give it a
    # moment and then shut down hard.
    pid=$(cat "$PID_FILE")
    kill -QUIT "$pid"
    for _ in 1 2 3 4 5; do
        nginx_running || break
        sleep 0.4 2>/dev/null || sleep 1
    done
    if nginx_running; then
        kill -TERM "$pid"
        for _ in 1 2 3 4 5; do
            nginx_running || break
            sleep 0.4 2>/dev/null || sleep 1
        done
    fi
    if nginx_running; then
        kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi
    if nginx_running; then
        echo "FAIL"
        return 1
    fi
    rm -f "$PID_FILE"
    echo "OK"
}

restart() {
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
