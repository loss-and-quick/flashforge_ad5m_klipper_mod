From 9ff36955b7f2ca296341bb3a4d78b20ef6ff2ae2 Mon Sep 17 00:00:00 2001
From: minicx <minicx@disroot.org>
Date: Fri, 20 Nov 2026 08:25:00 +0300
Subject: [PATCH 2/3] sunxi: Add FlashForge Adventurer 5M device tree

---
 arch/arm/dts/Makefile                        |  3 +-
 arch/arm/dts/sun8i-t113s-flashforge-ad5m.dts | 61 ++++++++++++++++++++
 2 files changed, 63 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/sun8i-t113s-flashforge-ad5m.dts

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 2d931c23..1eaf72e9 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -654,7 +654,8 @@ dtb-$(CONFIG_MACH_SUN8I_V3S) += \
 	sun8i-v3-sl631-imx179.dtb \
 	sun8i-v3s-licheepi-zero.dtb
 dtb-$(CONFIG_MACH_SUN8I_R528) += \
-	sun8i-t113s-mangopi-mq-r-t113.dtb
+	sun8i-t113s-mangopi-mq-r-t113.dtb \
+	sun8i-t113s-flashforge-ad5m.dtb
 dtb-$(CONFIG_MACH_SUN50I_H5) += \
 	sun50i-h5-bananapi-m2-plus.dtb \
 	sun50i-h5-emlid-neutis-n5-devboard.dtb \
diff --git a/arch/arm/dts/sun8i-t113s-flashforge-ad5m.dts b/arch/arm/dts/sun8i-t113s-flashforge-ad5m.dts
new file mode 100644
index 00000000..2e1509d8
--- /dev/null
+++ b/arch/arm/dts/sun8i-t113s-flashforge-ad5m.dts
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree Source for FlashForge Adventurer 5M (U-Boot)
+ */
+
+/dts-v1/;
+
+#include "sun8i-t113s.dtsi"
+
+/ {
+	model = "FlashForge Adventurer 5M";
+	compatible = "flashforge,adventurer5m", "allwinner,sun8i-t113s";
+
+	aliases {
+		serial3 = &uart3;
+		mmc0 = &mmc0;
+	};
+
+	chosen {
+		stdout-path = "serial3:115200n8";
+	};
+
+	reg_vcc3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+};
+
+&pio {
+	uart3_pg_pins: uart3-pg-pins {
+		pins = "PG8", "PG9";
+		function = "uart3";
+		bias-pull-up;
+	};
+
+	mmc0_pins: mmc0-pins {
+		pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
+		function = "mmc0";
+		drive-strength = <30>;
+		bias-pull-up;
+	};
+};
+
+&uart3 {
+	clock-frequency = <24000000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart3_pg_pins>;
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc0_pins>;
+	bus-width = <4>;
+	non-removable;
+	cap-mmc-highspeed;
+	status = "okay";
+};
-- 
