From 883a87013779c2d3c26ae13e8de66bbaa99435b7 Mon Sep 17 00:00:00 2001
From: minicx <minicx@disroot.org>
Date: Tue, 9 Sep 2025 13:10:24 +0300
Subject: [PATCH] normalize PSD arrays to match frequency array length

Signed-off-by: minicx <minicx@disroot.org>
---
 shaketune/graph_creators/plotters/shaper_plotter.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/shaketune/graph_creators/plotters/shaper_plotter.py b/shaketune/graph_creators/plotters/shaper_plotter.py
index ee7f36f..60b9fe6 100644
--- a/shaketune/graph_creators/plotters/shaper_plotter.py
+++ b/shaketune/graph_creators/plotters/shaper_plotter.py
@@ -11,6 +11,7 @@ from typing import Any, Dict
 
 import matplotlib
 import matplotlib.pyplot as plt
+import numpy as np
 from matplotlib.figure import Figure
 
 from ..base_models import PlotterStrategy
@@ -117,6 +118,17 @@ class ShaperPlotter(PlotterStrategy):
         py = calibration_data.psd_y
         pz = calibration_data.psd_z
 
+        # Ensure all arrays have the same length
+        expected_length = len(freqs)
+        if len(psd) != expected_length:
+            psd = psd[:expected_length] if len(psd) > expected_length else np.pad(psd, (0, expected_length - len(psd)))
+        if len(px) != expected_length:
+            px = px[:expected_length] if len(px) > expected_length else np.pad(px, (0, expected_length - len(px)))
+        if len(py) != expected_length:
+            py = py[:expected_length] if len(py) > expected_length else np.pad(py, (0, expected_length - len(py)))
+        if len(pz) != expected_length:
+            pz = pz[:expected_length] if len(pz) > expected_length else np.pad(pz, (0, expected_length - len(pz)))
+
         # Plot PSDs
         ax.plot(freqs, psd, label='X+Y+Z', color='purple', zorder=5)
         ax.plot(freqs, px, label='X', color='red')
@@ -129,35 +141,73 @@ class ShaperPlotter(PlotterStrategy):
         ax_2 = ax.twinx()
         ax_2.yaxis.set_visible(False)
         for shaper in data['shapers']:
-            ax_2.plot(freqs, shaper.vals, label=shaper.name.upper(), linestyle='dotted')
+            # Ensure shaper vals have the same length as freqs
+            shaper_vals = shaper.vals
+            if len(shaper_vals) != expected_length:
+                if len(shaper_vals) > expected_length:
+                    shaper_vals = shaper_vals[:expected_length]
+                else:
+                    shaper_vals = np.pad(shaper_vals, (0, expected_length - len(shaper_vals)))
+            ax_2.plot(freqs, shaper_vals, label=shaper.name.upper(), linestyle='dotted')
 
         # Draw shaper filtered PSDs
         shaper_choices = data['shaper_choices']
         for shaper in data['shaper_table_data']['shapers']:
             if shaper['type'] == shaper_choices[0]:
-                ax.plot(freqs, psd * shaper['vals'], label=f'With {shaper_choices[0]} applied', color='cyan')
+                shaper_vals = np.array(shaper['vals'])
+                if len(shaper_vals) != expected_length:
+                    if len(shaper_vals) > expected_length:
+                        shaper_vals = shaper_vals[:expected_length]
+                    else:
+                        shaper_vals = np.pad(shaper_vals, (0, expected_length - len(shaper_vals)))
+                ax.plot(freqs, psd * shaper_vals, label=f'With {shaper_choices[0]} applied', color='cyan')
             if len(shaper_choices) > 1 and shaper['type'] == shaper_choices[1]:
-                ax.plot(freqs, psd * shaper['vals'], label=f'With {shaper_choices[1]} applied', color='lime')
+                shaper_vals = np.array(shaper['vals'])
+                if len(shaper_vals) != expected_length:
+                    if len(shaper_vals) > expected_length:
+                        shaper_vals = shaper_vals[:expected_length]
+                    else:
+                        shaper_vals = np.pad(shaper_vals, (0, expected_length - len(shaper_vals)))
+                ax.plot(freqs, psd * shaper_vals, label=f'With {shaper_choices[1]} applied', color='lime')
 
         # Draw detected peaks
         peaks = data['peaks']
         peaks_freqs = data['peaks_freqs']
         peaks_threshold = data['peaks_threshold']
 
-        ax.plot(peaks_freqs, psd[peaks], 'x', color='black', markersize=8)
-        for idx, peak in enumerate(peaks):
-            fontcolor = 'red' if psd[peak] > peaks_threshold[1] else 'black'
-            fontweight = 'bold' if psd[peak] > peaks_threshold[1] else 'normal'
-            ax.annotate(
-                f'{idx + 1}',
-                (freqs[peak], psd[peak]),
-                textcoords='offset points',
-                xytext=(8, 5),
-                ha='left',
-                fontsize=13,
-                color=fontcolor,
-                weight=fontweight,
-            )
+        # Filter valid peaks that are within the current frequency range
+        valid_peaks = []
+        valid_peaks_freqs = []
+        
+        for i, peak_idx in enumerate(peaks):
+            if peak_idx < len(psd) and i < len(peaks_freqs):
+                # Check if peak frequency is within our current frequency range
+                peak_freq = peaks_freqs[i]
+                if peak_freq <= data['max_freq']:
+                    valid_peaks.append(peak_idx)
+                    valid_peaks_freqs.append(peak_freq)
+
+        # Plot valid peaks only
+        if len(valid_peaks) > 0:
+            valid_peaks = np.array(valid_peaks)
+            valid_peaks_freqs = np.array(valid_peaks_freqs)
+            
+            # Use peak frequencies directly instead of relying on indices
+            ax.plot(valid_peaks_freqs, psd[valid_peaks], 'x', color='black', markersize=8)
+            
+            for idx, (peak_idx, peak_freq) in enumerate(zip(valid_peaks, valid_peaks_freqs)):
+                fontcolor = 'red' if psd[peak_idx] > peaks_threshold[1] else 'black'
+                fontweight = 'bold' if psd[peak_idx] > peaks_threshold[1] else 'normal'
+                ax.annotate(
+                    f'{idx + 1}',
+                    (peak_freq, psd[peak_idx]),
+                    textcoords='offset points',
+                    xytext=(8, 5),
+                    ha='left',
+                    fontsize=13,
+                    color=fontcolor,
+                    weight=fontweight,
+                )
 
         # Add threshold lines and regions
         ax.axhline(y=peaks_threshold[0], color='black', linestyle='--', linewidth=0.5)
@@ -190,17 +240,18 @@ class ShaperPlotter(PlotterStrategy):
 
         # Add peaks lines in the spectrogram
         for idx, peak in enumerate(data['peaks_freqs']):
-            ax.axvline(peak, color='cyan', linestyle='dotted', linewidth=1)
-            ax.annotate(
-                f'Peak {idx + 1} ({peak:.1f} Hz)',
-                (peak, data['bins'][-1] * 0.9),
-                textcoords='data',
-                color='cyan',
-                rotation=90,
-                fontsize=10,
-                verticalalignment='top',
-                horizontalalignment='right',
-            )
+            if peak <= data['max_freq']:  # Only show peaks within frequency range
+                ax.axvline(peak, color='cyan', linestyle='dotted', linewidth=1)
+                ax.annotate(
+                    f'Peak {idx + 1} ({peak:.1f} Hz)',
+                    (peak, data['bins'][-1] * 0.9),
+                    textcoords='data',
+                    color='cyan',
+                    rotation=90,
+                    fontsize=10,
+                    verticalalignment='top',
+                    horizontalalignment='right',
+                )
 
         ax.set_xlim([0.0, data['max_freq']])
         AxesConfiguration.configure_axes(
