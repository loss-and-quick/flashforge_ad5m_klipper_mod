From: minicx <minicx@disroot.org>
Date: Fri, 20 Nov 2026 08:19:00 +0300
Subject: [PATCH] input: touchscreen: sun4i-ts: support the sun8i TPADC

The D1/T113 touch panel ADC is a different block from the older RTP
controllers: the TP_CTRL1 mode bits sit one position higher, the ADC
needs its own sample period and acquisition window, the pressure sample
reaches the FIFO through a touch-down interrupt, and the module clock and
reset are separate from the GPADC ones.

Program those registers for "allwinner,sun8i-ts" and enable the module
and bus clocks plus the reset in probe, so the resistive panel reports
coordinates instead of staying silent. Skip the hwmon and thermal
registration on that variant: it has no thermal zone in the device tree
and its temperature is unused, which otherwise turned the probe into a
hard failure.

Signed-off-by: minicx <minicx@disroot.org>
---
 drivers/input/touchscreen/sun4i-ts.c | 88 ++++++++++++++++++++++++++++++++----
 1 file changed, 84 insertions(+), 4 deletions(-)

--- a/drivers/input/touchscreen/sun4i-ts.c
+++ b/drivers/input/touchscreen/sun4i-ts.c
@@ -38,6 +38,8 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/clk.h>
+#include <linux/reset.h>
 
 #define TP_CTRL0		0x00
 #define TP_CTRL1		0x04
@@ -70,6 +72,10 @@
 /* on sun6i, bits 3~6 are left shifted by 1 to 4~7 */
 #define SUN6I_TP_MODE_EN(x)	((x) << 5)
 
+/* the sun8i TPADC keeps that shift and adds a chopper enable bit */
+#define SUN8I_CHOPPER_EN(x)	((x) << 8)
+#define SUN8I_TP_MODE_EN(x)	((x) << 5)
+
 /* TP_CTRL2 bits */
 #define TP_SENSITIVE_ADJUST(x)	((x) << 28) /* 4 bits */
 #define TP_MODE_SELECT(x)	((x) << 26) /* 2 bits */
@@ -165,10 +171,21 @@
 static int sun4i_ts_open(struct input_dev *dev)
 {
 	struct sun4i_ts_data *ts = input_get_drvdata(dev);
+	struct device_node *np = ts->dev->of_node;
+	u32 reg_val;
 
 	/* Flush, set trig level to 1, enable temp, data and up irqs */
-	writel(TEMP_IRQ_EN(1) | DATA_IRQ_EN(1) | FIFO_TRIG(1) | FIFO_FLUSH(1) |
-		TP_UP_IRQ_EN(1), ts->base + TP_INT_FIFOC);
+	reg_val = TEMP_IRQ_EN(1) | DATA_IRQ_EN(1) | FIFO_TRIG(1) |
+		  FIFO_FLUSH(1) | TP_UP_IRQ_EN(1);
+
+	/*
+	 * The sun8i TPADC raises a touch-down interrupt and reports the
+	 * pressure sample through the data FIFO.
+	 */
+	if (of_device_is_compatible(np, "allwinner,sun8i-ts"))
+		reg_val |= OVERRUN_IRQ_EN(1) | DATA_DRQ_EN(1) | TP_DOWN_IRQ_EN(1);
+
+	writel(reg_val, ts->base + TP_INT_FIFOC);
 
 	return 0;
 }
@@ -244,6 +261,9 @@
 	u32 tp_sensitive_adjust = 15;
 	u32 filter_type = 1;
 
+	struct reset_control *rst;
+	struct clk *clk;
+
 	ts = devm_kzalloc(dev, sizeof(struct sun4i_ts_data), GFP_KERNEL);
 	if (!ts)
 		return -ENOMEM;
@@ -251,6 +271,22 @@
 	ts->dev = dev;
 	ts->ignore_fifo_data = true;
 	ts->temp_data = -1;
+
+	rst = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(rst))
+		return PTR_ERR(rst);
+	error = reset_control_deassert(rst);
+	if (error)
+		return error;
+
+	clk = devm_clk_get_optional_enabled(dev, "mod");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	clk = devm_clk_get_optional_enabled(dev, "bus");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
 	if (of_device_is_compatible(np, "allwinner,sun6i-a31-ts")) {
 		/* Allwinner SDK has temperature (C) = (value / 6) - 271 */
 		ts->temp_offset = 271000;
@@ -318,6 +354,16 @@
 	       ts->base + TP_CTRL0);
 
 	/*
+	 * The TPADC samples at four times the rate that FS_DIV(2) gives on
+	 * this clock, which is what makes the panel feel responsive. Keep
+	 * the vendor acquisition window so the coordinates stay stable.
+	 */
+	if (of_device_is_compatible(np, "allwinner,sun8i-ts"))
+		writel(ADC_FIRST_DLY(1) | ADC_FIRST_DLY_MODE(1) |
+		       ADC_CLK_DIV(0) | FS_DIV(5) | T_ACQ(5),
+		       ts->base + TP_CTRL0);
+
+	/*
 	 * tp_sensitive_adjust is an optional property
 	 * tp_mode = 0 : only x and y coordinates, as we don't use dual touch
 	 */
@@ -326,6 +372,11 @@
 	writel(TP_SENSITIVE_ADJUST(tp_sensitive_adjust) | TP_MODE_SELECT(0),
 	       ts->base + TP_CTRL2);
 
+	/* Only report a touch once the panel settles above the threshold. */
+	if (of_device_is_compatible(np, "allwinner,sun8i-ts"))
+		writel(readl(ts->base + TP_CTRL2) | PRE_MEA_THRE_CNT(0xfff),
+		       ts->base + TP_CTRL2);
+
 	/*
 	 * Enable median and averaging filter, optional property for
 	 * filter type.
@@ -334,7 +385,8 @@
 	writel(FILTER_EN(1) | FILTER_TYPE(filter_type), ts->base + TP_CTRL3);
 
 	/* Enable temperature measurement, period 1953 (2 seconds) */
-	writel(TEMP_ENABLE(1) | TEMP_PERIOD(1953), ts->base + TP_TPR);
+	if (!of_device_is_compatible(np, "allwinner,sun8i-ts"))
+		writel(TEMP_ENABLE(1) | TEMP_PERIOD(1953), ts->base + TP_TPR);
 
 	/*
 	 * Set stylus up debounce to aprox 10 ms, enable debounce, and
@@ -343,6 +395,8 @@
 	reg = STYLUS_UP_DEBOUN(5) | STYLUS_UP_DEBOUN_EN(1);
 	if (of_device_is_compatible(np, "allwinner,sun6i-a31-ts"))
 		reg |= SUN6I_TP_MODE_EN(1);
+	else if (of_device_is_compatible(np, "allwinner,sun8i-ts"))
+		reg |= SUN8I_TP_MODE_EN(1) | SUN8I_CHOPPER_EN(1);
 	else
 		reg |= TP_MODE_EN(1);
 	writel(reg, ts->base + TP_CTRL1);
@@ -351,15 +405,23 @@
 	 * The thermal core does not register hwmon devices for DT-based
 	 * thermal zone sensors, such as this one.
 	 */
-	hwmon = devm_hwmon_device_register_with_groups(ts->dev, "sun4i_ts",
-						       ts, sun4i_ts_groups);
-	if (IS_ERR(hwmon))
-		return PTR_ERR(hwmon);
-
-	thermal = devm_thermal_of_zone_register(ts->dev, 0, ts,
-						&sun4i_ts_tz_ops);
-	if (IS_ERR(thermal))
-		return PTR_ERR(thermal);
+	if (!of_device_is_compatible(np, "allwinner,sun8i-ts")) {
+		hwmon = devm_hwmon_device_register_with_groups(ts->dev, "sun4i_ts",
+							      ts, sun4i_ts_groups);
+		if (IS_ERR(hwmon))
+			return PTR_ERR(hwmon);
+	}
+
+	/*
+	 * The TPADC variant shares the block but has no thermal zone in the
+	 * device tree, and its temperature is not used.
+	 */
+	if (!of_device_is_compatible(np, "allwinner,sun8i-ts")) {
+		thermal = devm_thermal_of_zone_register(ts->dev, 0, ts,
+							&sun4i_ts_tz_ops);
+		if (IS_ERR(thermal))
+			return PTR_ERR(thermal);
+	}
 
 	writel(TEMP_IRQ_EN(1), ts->base + TP_INT_FIFOC);
 
@@ -393,6 +455,7 @@
 	{ .compatible = "allwinner,sun4i-a10-ts", },
 	{ .compatible = "allwinner,sun5i-a13-ts", },
 	{ .compatible = "allwinner,sun6i-a31-ts", },
+	{ .compatible = "allwinner,sun8i-ts", },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sun4i_ts_of_match);
