From 5cce72818346663e5a1fae398371906150fa26be Mon Sep 17 00:00:00 2001
From: minicx <minicx@disroot.org>
Date: Fri, 20 Nov 2026 08:24:04 +0300
Subject: [PATCH 1/3] sunxi: Add UART3 pinmux on Port G for R528/T113

---
 arch/arm/mach-sunxi/Kconfig           | 7 +++++++
 arch/arm/mach-sunxi/board.c           | 6 ++++++
 drivers/pinctrl/sunxi/pinctrl-sunxi.c | 4 ++++
 3 files changed, 17 insertions(+)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 17666814..f723c3e2 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -746,6 +746,13 @@ config UART0_PORT_F
 	at the same time, the system can be only booted in the FEL mode.
 	Only enable this if you really know what you are doing.
 
+config MACH_SUN8I_R528_UART3_ON_PORTG
+	bool "UART3 on Port G (PG8/PG9) for R528/T113"
+	depends on MACH_SUN8I_R528
+	help
+	  Select this option if UART3 console is routed to PG8/PG9 instead
+	  of PB6/PB7 (e.g. on FlashForge Adventurer 5M).
+
 config OLD_SUNXI_KERNEL_COMPAT
 	bool "Enable workarounds for booting old kernels"
 	---help---
diff --git a/arch/arm/mach-sunxi/board.c b/arch/arm/mach-sunxi/board.c
index 046e9fbf..4ec4b8f7 100644
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -167,9 +167,15 @@ static int gpio_init(void)
 	sunxi_gpio_set_cfgpin(SUNXI_GPB(1), SUN8I_GPB_UART2);
 	sunxi_gpio_set_pull(SUNXI_GPB(1), SUNXI_GPIO_PULL_UP);
 #elif CONFIG_CONS_INDEX == 4 && defined(CONFIG_MACH_SUN8I_R528)
+#ifdef CONFIG_MACH_SUN8I_R528_UART3_ON_PORTG
+	sunxi_gpio_set_cfgpin(SUNXI_GPG(8), 5);
+	sunxi_gpio_set_cfgpin(SUNXI_GPG(9), 5);
+	sunxi_gpio_set_pull(SUNXI_GPG(9), SUNXI_GPIO_PULL_UP);
+#else
 	sunxi_gpio_set_cfgpin(SUNXI_GPB(6), 7);
 	sunxi_gpio_set_cfgpin(SUNXI_GPB(7), 7);
 	sunxi_gpio_set_pull(SUNXI_GPB(7), SUNXI_GPIO_PULL_UP);
+#endif
 #elif CONFIG_CONS_INDEX == 5 && defined(CONFIG_MACH_SUN8I)
 	sunxi_gpio_set_cfgpin(SUNXI_GPL(2), SUN8I_GPL_R_UART);
 	sunxi_gpio_set_cfgpin(SUNXI_GPL(3), SUN8I_GPL_R_UART);
diff --git a/drivers/pinctrl/sunxi/pinctrl-sunxi.c b/drivers/pinctrl/sunxi/pinctrl-sunxi.c
index 37ea9371..96bd4eca 100644
--- a/drivers/pinctrl/sunxi/pinctrl-sunxi.c
+++ b/drivers/pinctrl/sunxi/pinctrl-sunxi.c
@@ -614,7 +614,11 @@ static const struct sunxi_pinctrl_function sun20i_d1_pinctrl_functions[] = {
 #endif
 	{ "uart1",	2 },	/* PG6-PG7 */
 	{ "uart2",	7 },	/* PB0-PB1 */
+#if IS_ENABLED(CONFIG_MACH_SUN8I_R528_UART3_ON_PORTG)
+	{ "uart3",	5 },	/* PG8-PG9 */
+#else
 	{ "uart3",	7 },	/* PB6-PB7 */
+#endif
 };
 
 static const struct sunxi_pinctrl_desc __maybe_unused sun20i_d1_pinctrl_desc = {
-- 
2.56.0

